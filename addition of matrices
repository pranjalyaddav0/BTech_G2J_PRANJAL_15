#include <stdio.h>
#include <stdlib.h>

#define MAX 50 // Maximum allowed rows/columns

int main() {
    int rows, cols;
    int mat1[MAX][MAX], mat2[MAX][MAX], sum[MAX][MAX];
    int i, j;

    // Read matrix dimensions
    printf("Enter number of rows and columns (max %d): ", MAX);
    if (scanf("%d %d", &rows, &cols) != 2 || rows <= 0 || cols <= 0 || rows > MAX || cols > MAX) {
        printf("Invalid dimensions.\n");
        return 1;
    }

    // Read first matrix
    printf("Enter elements of first matrix (%d x %d):\n", rows, cols);
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            if (scanf("%d", &mat1[i][j]) != 1) {
                printf("Invalid input.\n");
                return 1;
            }
        }
    }

    // Read second matrix
    printf("Enter elements of second matrix (%d x %d):\n", rows, cols);
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            if (scanf("%d", &mat2[i][j]) != 1) {
                printf("Invalid input.\n");
                return 1;
            }
        }
    }

    // Calculate sum of matrices
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            sum[i][j] = mat1[i][j] + mat2[i][j];
        }
    }

    // Display result
    printf("\nSum of the two matrices:\n");
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("%d\t", sum[i][j]);
        }
        printf("\n");
    }

    return 0;
}
